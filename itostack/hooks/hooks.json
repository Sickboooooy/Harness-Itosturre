{
  "description": "Guardias deterministas de itostack: arquitectura, citas con evidencia, compuerta humana y Prove It Works. El lanzador Node busca Python en cualquier plataforma y, si una guardia no puede evaluar, deniega (falla cerrado).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lanzar.mjs\" inicio_sesion.py abierto SessionStart", "timeout": 20 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lanzar.mjs\" captura_correcciones.py abierto UserPromptSubmit", "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lanzar.mjs\" guardia_bash.py cerrado PreToolUse", "timeout": 20 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lanzar.mjs\" guardia_escritura.py cerrado PreToolUse", "timeout": 20 }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lanzar.mjs\" guardia_lectura.py cerrado PreToolUse", "timeout": 20 }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lanzar.mjs\" guardia_externo.py cerrado PreToolUse", "timeout": 20 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lanzar.mjs\" guardia_cierre.py abierto Stop", "timeout": 20 }
        ]
      }
    ]
  }
}
